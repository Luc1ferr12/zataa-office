# Tim Trading XAUUSD kantor Zataa (bridge EA MT5 + siklus agent tiap M15, restart otomatis)
# pasang: sudo cp scripts/vps/zataa-trading.service /etc/systemd/system/ && sudo systemctl enable --now zataa-trading
# .env: TRD_TOKEN=<rahasia panjang> (sama dengan input Token di EA), TRD_PORT=8787, TRD_AI=1 (ringkasan sentimen Davina via Claude)
[Unit]
Description=Zataa AI Office - tim Trading XAUUSD
After=network-online.target
Wants=network-online.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/zataa-office
Environment=PATH=/home/ubuntu/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=TZ=Asia/Makassar
ExecStart=/usr/bin/node scripts/trading/run.mjs
Restart=always
RestartSec=15
StandardOutput=append:/home/ubuntu/zataa-office/logs/trading.log
StandardError=append:/home/ubuntu/zataa-office/logs/trading.log

[Install]
WantedBy=multi-user.target
